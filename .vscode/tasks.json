{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Orchestrator: Install",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/orchestrator"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Orchestrator: Start Everything (One Command)",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/orchestrator"
      },
      "dependsOn": ["Orchestrator: Install"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Dispatch Core: Install Elixir Deps",
      "type": "shell",
      "command": "mix deps.get",
      "options": {
        "cwd": "${workspaceFolder}/dispatch_core"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Dispatch Core: Run",
      "type": "shell",
      "command": "mix run --no-halt",
      "options": {
        "cwd": "${workspaceFolder}/dispatch_core"
      },
      "dependsOn": ["Dispatch Core: Install Elixir Deps"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Dashboard: Build Elm App",
      "type": "shell",
      "command": "elm make src/Main.elm --output=main.js",
      "options": {
        "cwd": "${workspaceFolder}/dashboard"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "ETA Service: Run (Haskell)",
      "type": "shell",
      "command": "stack build && stack exec eta-service-exe",
      "options": {
        "cwd": "${workspaceFolder}/eta_service"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Fare Service: Run (Scala)",
      "type": "shell",
      "command": "scala run src/main/scala/fareservice",
      "options": {
        "cwd": "${workspaceFolder}/fare_service"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Analytics Service: Run (Clojure)",
      "type": "shell",
      "command": "clojure -M -m rideanalytics.main",
      "options": {
        "cwd": "${workspaceFolder}/analytics_service"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Check All Service Health",
      "type": "shell",
      "command": "echo 'Haskell (4001):'; curl -s http://localhost:4001/health; echo; echo 'Scala (4002):'; curl -s http://localhost:4002/health; echo; echo 'Clojure (4003):'; curl -s http://localhost:4003/health; echo",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Start All Services (5 Terminals)",
      "dependsOn": [
        "Dispatch Core: Run",
        "Dashboard: Build Elm App",
        "ETA Service: Run (Haskell)",
        "Fare Service: Run (Scala)",
        "Analytics Service: Run (Clojure)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
